{
  "quality_thresholds": {
    "minimum_score": 15,
    "high_quality": 30,
    "content_length_min": 200,
    "content_length_max": 8000
  },
  "scoring_weights": {
    "keyword_relevance": 1.0,
    "domain_trust": 0.8,
    "content_quality": 1.2,
    "technical_depth": 1.5,
    "applicability": 1.3
  },
  "content_filters": {
    "require_code_examples": false,
    "require_technical_content": true,
    "exclude_pure_news": true,
    "exclude_promotional": true
  },
  "agentbnzo_optimization": {
    "crew_ai_bonus": 20,
    "multi_agent_bonus": 15,
    "automation_bonus": 12,
    "ai_evaluation_bonus": 18,
    "fabric_patterns_bonus": 16
  },
  "exclusion_patterns": {
    "entertainment_keywords": ["gaming", "games", "sports", "celebrity", "gossip", "entertainment"],
    "religion_keywords": ["religion", "religious", "faith", "spiritual", "church", "mosque", "temple"],
    "promotional_patterns": ["buy now", "limited time", "special offer", "discount", "sale"],
    "low_quality_indicators": ["click here", "you won't believe", "shocking", "amazing trick"]
  }
}